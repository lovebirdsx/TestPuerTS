{
  "version": "0.2.0",
  "configurations": [
      {
          "name": "Attach Editor",
          "port": 8888,
          "restart": true,
          "request": "attach",
          "skipFiles": [
              "<node_internals>/**"
          ],
          "outFiles": [
              "${workspaceFolder}/Content/JavaScript/**/*.js",
              "!**/node_modules/**"
          ],
          "type": "node"
      },
      {
          "name": "Run gulp ue:test",
          "type": "node",
          "request": "launch",
          "runtimeExecutable": "npx",
          "args": ["gulp", "ue:test", "--verbose"],
          "console": "integratedTerminal",
          "cwd": "${workspaceFolder}",
          "sourceMaps": true,
          "outFiles": [
              "${workspaceFolder}/packages/tool/out/**/*.js",
              "${workspaceFolder}/Content/JavaScript/**/*.js",
              "!**/node_modules/**"
          ]
      },
      {
          "name": "Run gulp editor:watch",
          "type": "node",
          "request": "launch",
          "runtimeExecutable": "npx",
          "args": ["gulp", "editor:watch", "--verbose"],
          "console": "integratedTerminal",
          "cwd": "${workspaceFolder}",
          "sourceMaps": true,
          "outFiles": [
              "${workspaceFolder}/packages/tool/out/**/*.js",
              "${workspaceFolder}/Content/JavaScript/**/*.js",
              "!**/node_modules/**"
          ]
      },
  ]
}
