{
  "version": "0.2.0",
  "configurations": [
      {
          "name": "Attach Editor",
          "port": 8889,
          "restart": false,
          "request": "attach",
          "skipFiles": [
              "<node_internals>/**"
          ],
          "outFiles": [
              "${workspaceFolder}/Content/JavaScript/**/*.js",
              "!**/node_modules/**"
          ],
          "type": "node"
      },
      {
          "name": "Debug Tests",
          "type": "node",
          "request": "attach",
          "port": 9229,
          "address": "127.0.0.1",
          "restart": false,
          "timeout": 10000,
          "preLaunchTask": "ue:test:debug",
          "sourceMaps": true,
          "outFiles": [
              "${workspaceFolder}/Content/JavaScript/tests/**/*.js",
              "${workspaceFolder}/Content/JavaScript/editor-common/**/*.js",
              "${workspaceFolder}/Content/JavaScript/editor/**/*.js",
              "${workspaceFolder}/Content/JavaScript/mcp-server-ue/**/*.js",
              "!**/node_modules/**"
          ],
          "skipFiles": [
              "<node_internals>/**"
          ]
      }
  ]
}
