{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "../../Content/JavaScript/mcp-server-ue",
		"tsBuildInfoFile": "./tsconfig.tsbuildinfo",
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"baseUrl": ".",
		"paths": {
			"@modelcontextprotocol/sdk/dist/cjs/*": [
				"../../node_modules/@modelcontextprotocol/sdk/dist/esm/*"
