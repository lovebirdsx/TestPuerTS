{
	"compilerOptions": {
		"target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
		"jsx": "react",
    "removeComments": true,
		"sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "allowJs": true,
		"rootDir": "./src",
		"outDir": "./out",
	},
	"include": [
		"./src"
	],
	"exclude": [
		"./out",
		"./dist",
	]
}
